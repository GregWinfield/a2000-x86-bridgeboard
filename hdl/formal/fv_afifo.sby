# SPDX-License-Identifier: MIT
# Async FIFO proof (sheet 4, owner requirement 5): independent free clocks (multiclock), arbitrary
# reset, free enables and data. prove = k-induction; bmc and cover as for the other proofs.
[tasks]
prove
bmc
cover

[options]
multiclock on
prove: mode prove
prove: depth 24
bmc: mode bmc
bmc: depth 60
cover: mode cover
cover: depth 80

[engines]
smtbmc yices

[script]
read_verilog -formal -DFORMAL z2_afifo.v
read_verilog -formal fv_afifo.v
prep -top fv_afifo

[files]
../rtl/z2_afifo.v
fv_afifo.v
