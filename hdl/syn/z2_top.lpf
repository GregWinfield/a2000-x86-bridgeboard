# SPDX-License-Identifier: MIT
# Lattice preference file for z2_top, LCMXO2-2000HC-4TG144C (Diamond). Gate G-STA (C-01).
# The 18 ns MAXDELAY values are the sheet-1 ALLOCATION for the FPGA pin-to-pin share of the
# 35 ns /SLAVEn budget (docs/stage2/sheet1-timing-budget.md). They are requirements to be
# proven by post-place-and-route analysis, not proven values.
# Pin LOCATEs are assigned with sheet 2; until then Diamond places the I/O (exploration only).
# Syntax follows the Lattice Diamond preference reference [K]; check it on the first Diamond run.

BLOCK RESETPATHS ;
BLOCK ASYNCPATHS ;
FREQUENCY PORT "clk_core" 50.000000 MHz ;

# ---------------- /SLAVEn: assertion (from /AS and from the late-address case) and release.
# MIN 0 ns makes TRACE's hold analysis report each path's MINIMUM delay (slack = delay), which the
# C-02 hazard inequality needs (docs/stage2/sheet1-hazard-analysis.md section 4.2).
MAXDELAY FROM PORT "ZB_AS_N"   TO PORT "ZF_SLAVE_N" 18.000000 ns MIN 0.000000 ns ;
MAXDELAY FROM PORT "ZB_A[16]"  TO PORT "ZF_SLAVE_N" 18.000000 ns MIN 0.000000 ns ;
MAXDELAY FROM PORT "ZB_A[17]"  TO PORT "ZF_SLAVE_N" 18.000000 ns MIN 0.000000 ns ;
MAXDELAY FROM PORT "ZB_A[18]"  TO PORT "ZF_SLAVE_N" 18.000000 ns MIN 0.000000 ns ;
MAXDELAY FROM PORT "ZB_A[19]"  TO PORT "ZF_SLAVE_N" 18.000000 ns MIN 0.000000 ns ;
MAXDELAY FROM PORT "ZB_A[20]"  TO PORT "ZF_SLAVE_N" 18.000000 ns MIN 0.000000 ns ;
MAXDELAY FROM PORT "ZB_A[21]"  TO PORT "ZF_SLAVE_N" 18.000000 ns MIN 0.000000 ns ;
MAXDELAY FROM PORT "ZB_A[22]"  TO PORT "ZF_SLAVE_N" 18.000000 ns MIN 0.000000 ns ;
MAXDELAY FROM PORT "ZB_A[23]"  TO PORT "ZF_SLAVE_N" 18.000000 ns MIN 0.000000 ns ;

# ---------------- XRDY (60 ns limit after /AS; released on /AS negation and on /BERR)
MAXDELAY FROM PORT "ZB_AS_N"   TO PORT "ZF_XRDY" 18.000000 ns ;
MAXDELAY FROM PORT "ZB_BERR_N" TO PORT "ZF_XRDY" 18.000000 ns ;
MAXDELAY FROM PORT "ZB_A[16]"  TO PORT "ZF_XRDY" 18.000000 ns ;
MAXDELAY FROM PORT "ZB_A[17]"  TO PORT "ZF_XRDY" 18.000000 ns ;
MAXDELAY FROM PORT "ZB_A[18]"  TO PORT "ZF_XRDY" 18.000000 ns ;
MAXDELAY FROM PORT "ZB_A[19]"  TO PORT "ZF_XRDY" 18.000000 ns ;
MAXDELAY FROM PORT "ZB_A[20]"  TO PORT "ZF_XRDY" 18.000000 ns ;
MAXDELAY FROM PORT "ZB_A[21]"  TO PORT "ZF_XRDY" 18.000000 ns ;
MAXDELAY FROM PORT "ZB_A[22]"  TO PORT "ZF_XRDY" 18.000000 ns ;
MAXDELAY FROM PORT "ZB_A[23]"  TO PORT "ZF_XRDY" 18.000000 ns ;

# ---------------- data-buffer enable (release on /AS, /BERR, DOE, READ, strobes)
MAXDELAY FROM PORT "ZB_AS_N"   TO PORT "ZF_DBUF_OE_N" 18.000000 ns ;
MAXDELAY FROM PORT "ZB_BERR_N" TO PORT "ZF_DBUF_OE_N" 18.000000 ns ;
MAXDELAY FROM PORT "ZB_DOE"    TO PORT "ZF_DBUF_OE_N" 18.000000 ns ;
MAXDELAY FROM PORT "ZB_READ"   TO PORT "ZF_DBUF_OE_N" 18.000000 ns ;
MAXDELAY FROM PORT "ZB_UDS_N"  TO PORT "ZF_DBUF_OE_N" 18.000000 ns ;
MAXDELAY FROM PORT "ZB_LDS_N"  TO PORT "ZF_DBUF_OE_N" 18.000000 ns ;

# ---------------- /CFGOUTn follows /CFGINn (not timing critical)
MAXDELAY FROM PORT "ZB_CFGIN_N" TO PORT "ZF_CFGOUT_N" 25.000000 ns ;

# ---------------- output loading for timing (Diamond default is 0 pF). Each FPGA output drives one
# LVC input: SN74LVC8T245 A port Cio 8.5 pF typ (S53), SN74LVC32A Ci 5 pF (S55), LVCH16T245 DIR
# 4-5 pF x 2 (S46), plus trace and test pad. 15 pF is a conservative bound for all of them.
OUTPUT ALLPORTS LOAD 15.000000 pF ;

# ---------------- I/O standards. EVERY bank runs at VCCIO = 3.3 V (pin matrix section 4), so every
# port is LVCMOS33. Diamond's default for a port without an IO_TYPE is LVCMOS25, which also sets that
# bank's VCCIO to 2.5 V. The exploratory run of 2026-11-19 had IO_TYPE only on the ports listed below
# and analysed ZB_A[23:1], LD[15:1], clk_core, LED and DIP as LVCMOS25 (corrected 2026-11-19).
# ALLPORTS sets the default; per-port IOBUF lines below keep their own attributes [Diamond help:
# "Defining I/O Defaults"].
IOBUF ALLPORTS IO_TYPE=LVCMOS33 ;
# sheet-1 nets: no FPGA pulls, board resistors define the defaults
IOBUF PORT "ZF_SLAVE_N"   IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST PULLMODE=NONE ;
IOBUF PORT "ZF_XRDY"      IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST PULLMODE=NONE ;
IOBUF PORT "ZF_DBUF_OE_N" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=FAST PULLMODE=NONE ;
IOBUF PORT "ZF_DBUF_DIR"  IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=SLOW PULLMODE=NONE ;
IOBUF PORT "ZF_CFGOUT_N"  IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=SLOW PULLMODE=NONE ;
IOBUF PORT "ZF_INT2_N"    IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=SLOW PULLMODE=NONE ;
IOBUF PORT "ZF_INT6_N"    IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=SLOW PULLMODE=NONE ;
IOBUF PORT "ZF_OVR_N"     IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=SLOW PULLMODE=NONE ;
IOBUF PORT "ZF_DTACK_N"   IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=SLOW PULLMODE=NONE ;
IOBUF PORT "ZF_ARM"       IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=SLOW PULLMODE=NONE ;
IOBUF PORT "EN_OK"        IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "ZB_AS_N"      IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "ZB_UDS_N"     IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "ZB_LDS_N"     IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "ZB_READ"      IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "ZB_DOE"       IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "ZB_CFGIN_N"   IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "ZB_BUSRST_N"  IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "ZB_BERR_N"    IO_TYPE=LVCMOS33 PULLMODE=NONE ;
# ZB_E7M is unused in Stage 2 and removed by synthesis; re-enable its IOBUF when it gains a load:
# IOBUF PORT "ZB_E7M"       IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "clk_core"     IO_TYPE=LVCMOS33 PULLMODE=NONE ;
# address inputs (U101/U102 outputs, always driven) and the local data bus (U103 bus-hold: no FPGA pull)
IOBUF PORT "ZB_A[1]"  IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "ZB_A[2]"  IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "ZB_A[3]"  IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "ZB_A[4]"  IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "ZB_A[5]"  IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "ZB_A[6]"  IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "ZB_A[7]"  IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "ZB_A[8]"  IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "ZB_A[9]"  IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "ZB_A[10]" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "ZB_A[11]" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "ZB_A[12]" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "ZB_A[13]" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "ZB_A[14]" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "ZB_A[15]" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "ZB_A[16]" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "ZB_A[17]" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "ZB_A[18]" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "ZB_A[19]" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "ZB_A[20]" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "ZB_A[21]" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "ZB_A[22]" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "ZB_A[23]" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "LD[0]"  IO_TYPE=LVCMOS33 DRIVE=8 PULLMODE=NONE ;
IOBUF PORT "LD[1]"  IO_TYPE=LVCMOS33 DRIVE=8 PULLMODE=NONE ;
IOBUF PORT "LD[2]"  IO_TYPE=LVCMOS33 DRIVE=8 PULLMODE=NONE ;
IOBUF PORT "LD[3]"  IO_TYPE=LVCMOS33 DRIVE=8 PULLMODE=NONE ;
IOBUF PORT "LD[4]"  IO_TYPE=LVCMOS33 DRIVE=8 PULLMODE=NONE ;
IOBUF PORT "LD[5]"  IO_TYPE=LVCMOS33 DRIVE=8 PULLMODE=NONE ;
IOBUF PORT "LD[6]"  IO_TYPE=LVCMOS33 DRIVE=8 PULLMODE=NONE ;
IOBUF PORT "LD[7]"  IO_TYPE=LVCMOS33 DRIVE=8 PULLMODE=NONE ;
IOBUF PORT "LD[8]"  IO_TYPE=LVCMOS33 DRIVE=8 PULLMODE=NONE ;
IOBUF PORT "LD[9]"  IO_TYPE=LVCMOS33 DRIVE=8 PULLMODE=NONE ;
IOBUF PORT "LD[10]" IO_TYPE=LVCMOS33 DRIVE=8 PULLMODE=NONE ;
IOBUF PORT "LD[11]" IO_TYPE=LVCMOS33 DRIVE=8 PULLMODE=NONE ;
IOBUF PORT "LD[12]" IO_TYPE=LVCMOS33 DRIVE=8 PULLMODE=NONE ;
IOBUF PORT "LD[13]" IO_TYPE=LVCMOS33 DRIVE=8 PULLMODE=NONE ;
IOBUF PORT "LD[14]" IO_TYPE=LVCMOS33 DRIVE=8 PULLMODE=NONE ;
IOBUF PORT "LD[15]" IO_TYPE=LVCMOS33 DRIVE=8 PULLMODE=NONE ;
# LED and DIP ports take the ALLPORTS default (LVCMOS33, Diamond default pull) until sheet 6 defines them

# ---------------- pin LOCATEs: sheet 2 (TBD)
# LOCATE COMP "ZB_AS_N" SITE "<pin>" ;
