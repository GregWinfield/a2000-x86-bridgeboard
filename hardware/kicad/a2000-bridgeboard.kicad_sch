			)
			(justify left top)
		)
		(uuid "a17a1973-17c8-596c-91fd-182d4af81649")
	)
	(text "+3V3 and +5V_BUS are sourced by sheet 5 (not yet drawn). TEMPORARY PWR_FLAGs on sheet 1\ndeclare them driven so ERC can check sheets 1-3; remove them when sheet 5 exists."
