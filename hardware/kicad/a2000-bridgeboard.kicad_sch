		(comment 1 "Zorro II bridgeboard carrying a removable x86 SBC (Rev 1: Radxa X4).")
		(comment 2 "Hierarchy follows the brief: sheets 1-6. Sheets 1, 2 and 3 are drawn (Stages 2-3).")
		(comment 3 "TEMPORARY PWR_FLAGs on +3V3/+5V_BUS until sheet 5 exists.")
		(comment 4 "Licence: CERN-OHL-S-2.0")
	)
	(lib_symbols)
	(text "Sheets 1, 2 and 3 are joined by net labels at every sheet pin. ZF_OVR_N and ZF_DTACK_N are not\nFPGA pins (owner decision C-17): no-connect here, held inactive by R106/R107 on sheet 1.\nSheet-2 pins on its right edge belong to sheets 4-6 (not yet drawn) and are open until then;\nERC entries for them are listed in docs/stage2/sheet2-erc-report.md."
		(exclude_from_sim no)
		(at 38.1 251.46 0)
